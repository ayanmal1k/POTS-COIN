rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve existing rules for Admiral project collections
    match /translations/{document=**} {
      allow read, write: if true;
    }

    match /stats/{document=**} {
      allow read, write: if true;
    }

    match /info/{document=**} {
      allow read, write: if true;
    }

    // Tier X intake submissions
    match /tierx_submissions/{document=**} {
      allow read, write: if true;
    }

    match /intake_submissions/{document=**} {
      allow read, write: if true;
    }

    // Tier X admin credentials & system config
    match /tierx_admin/{document=**} {
      allow read, write: if true;
    }

    // POT Luck Community ($POT) site content collection
    match /pots/{document=**} {
      allow read, write: if true;
    }
    
    // Fallback block
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
